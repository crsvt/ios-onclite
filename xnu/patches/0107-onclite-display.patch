+#if defined(ONCLITE)
+/*
+ * Shadow canvas (/onclite-panel reg) and the splash pipe LK scans out. The
+ * shadow is outside xnu's RAM, so it is only ever mapped write-combined.
+ */
+bool
+AppleCLCD::panelSetup(void)
+{
+	DTEntry node;
+	uint64_t const *reg = NULL;
+	unsigned int size = 0;
+	if (SecureDTLookupEntry(NULL, "/onclite-panel", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess || size < 16) {
+		IOLog("ONCLITE FB: no /onclite-panel in the device tree\n");
+		return false;
+	}
+	fPhys = reg[0];
+	fWidth = SWEET_FB_LOGICAL_W;
+	fHeight = SWEET_FB_LOGICAL_H;
+	fRowBytes = SWEET_FB_LOGICAL_W * 4;
+	if ((uint64_t)fRowBytes * fHeight > reg[1]) {
+		IOLog("ONCLITE FB: shadow region 0x%llx too small\n", reg[1]);
+		return false;
+	}
+
+	/* LK's splash pipe: address in the splash region, RGB888. Defaults: probe. */
+	fPanelPhys = 0x90001000UL;
+	fPanelW = 720;
+	fPanelH = 1520;
+	fPanelStride = 720 * 3;
+	uint32_t unpack = 0x00020001;   /* B, G, R in memory */
+	vm_offset_t mdp = ml_io_map(ONC_MDP_PA, ONC_MDP_SIZE);
+	for (unsigned int i = 0; mdp && i < sizeof(onc_pipes) / sizeof(onc_pipes[0]); i++) {
+		vm_offset_t pipe = mdp + onc_pipes[i];
+		uint32_t addr = *(volatile uint32_t *)(pipe + ONC_SSPP_SRC0_ADDR);
+		uint32_t sz = *(volatile uint32_t *)(pipe + ONC_SSPP_SRC_SIZE);
+		uint32_t fmt = *(volatile uint32_t *)(pipe + ONC_SSPP_SRC_FORMAT);
+		if (addr < ONC_SPLASH_LO || addr >= ONC_SPLASH_HI || ((fmt >> 9) & 3) + 1 != 3) {
+			continue;
+		}
+		fPanelPhys = addr;
+		fPanelW = sz & 0xffff;
+		fPanelH = sz >> 16;
+		fPanelStride = *(volatile uint32_t *)(pipe + ONC_SSPP_SRC_YSTRIDE0) & 0xffff;
+		unpack = *(volatile uint32_t *)(pipe + ONC_SSPP_UNPACK);
+		IOLog("ONCLITE FB: splash pipe 0x%x: 0x%x %ux%u stride %u format 0x%x unpack 0x%x\n",
+		    onc_pipes[i], addr, fPanelW, fPanelH, fPanelStride, fmt, unpack);
+		break;
+	}
+	if (fPanelW < 64 || fPanelH < 64 || fPanelStride < fPanelW * 3) {
+		IOLog("ONCLITE FB: no usable splash pipe\n");
+		return false;
+	}
+	for (int b = 0; b < 3; b++) {
+		fByteComp[b] = (uint8_t)((unpack >> (8 * b)) & 3);
+	}
+	fPanel = ml_io_map_wcomb((vm_offset_t)fPanelPhys, round_page((uint64_t)fPanelStride * fPanelH));
+	if (fPanel == 0) {
+		return false;
+	}
+
+	/* Uniform scale that fits the canvas, centered. */
+	if ((uint64_t)fPanelW * fHeight <= (uint64_t)fPanelH * fWidth) {
+		fOutW = fPanelW;
+		fOutH = (uint32_t)((uint64_t)fHeight * fPanelW / fWidth);
+	} else {
+		fOutH = fPanelH;
+		fOutW = (uint32_t)((uint64_t)fWidth * fPanelH / fHeight);
+	}
+	fOutX = (fPanelW - fOutW) / 2;
+	fOutY = (fPanelH - fOutH) / 2;
+	fMapX = (uint32_t *)IOMallocData(fOutW * sizeof(uint32_t));
+	fMapY = (uint32_t *)IOMallocData(fOutH * sizeof(uint32_t));
+	if (fMapX == NULL || fMapY == NULL) {
+		return false;
+	}
+	for (uint32_t x = 0; x < fOutW; x++) {
+		fMapX[x] = (uint32_t)(((uint64_t)x * fWidth + fWidth / 2) / fOutW);
+	}
+	for (uint32_t y = 0; y < fOutH; y++) {
+		fMapY[y] = (uint32_t)(((uint64_t)y * fHeight + fHeight / 2) / fOutH);
+	}
+	/* Black panel (LK's logo would stay around the scaled canvas). */
+	for (uint32_t y = 0; y < fPanelH; y++) {
+		volatile uint8_t *row = (volatile uint8_t *)(fPanel + (uint64_t)y * fPanelStride);
+		for (uint32_t x = 0; x < fPanelW * 3; x++) {
+			row[x] = 0;
+		}
+	}
+	IOLog("ONCLITE FB: canvas %ux%u at 0x%llx -> panel %ux%u at 0x%llx (%ux%u at %u,%u)\n",
+	    fWidth, fHeight, fPhys, fPanelW, fPanelH, fPanelPhys, fOutW, fOutH, fOutX, fOutY);
+	return true;
+}
+
+/* Scale and convert the BGRA canvas (memory B, G, R, A) into the panel. */
+void
+AppleCLCD::panelCopy(void)
+{
+	if (fPanel == 0 || fPixels == 0) {
+		return;
+	}
+	for (uint32_t y = 0; y < fOutH; y++) {
+		const volatile uint32_t *src = (const volatile uint32_t *)(fPixels + (uint64_t)fMapY[y] * fRowBytes);
+		volatile uint8_t *dst = (volatile uint8_t *)(fPanel + (uint64_t)(fOutY + y) * fPanelStride + fOutX * 3);
+		for (uint32_t x = 0; x < fOutW; x++) {
+			uint32_t p = src[fMapX[x]];
+			uint8_t c[3] = { (uint8_t)(p >> 8), (uint8_t)p, (uint8_t)(p >> 16) };  /* G, B, R */
+			dst[0] = c[fByteComp[0]];
+			dst[1] = c[fByteComp[1]];
+			dst[2] = c[fByteComp[2]];
+			dst += 3;
+		}
+	}
+}
+#endif /* ONCLITE */
