+#define ONC_SSPP_SRC0_ADDR      0x14
+#define ONC_SSPP_SRC_YSTRIDE0   0x24
+#define ONC_SSPP_SRC_FORMAT     0x30
+#define ONC_SSPP_UNPACK         0x34
+#define ONC_SPLASH_LO           0x90000000UL
+#define ONC_SPLASH_HI           0x91400000UL
