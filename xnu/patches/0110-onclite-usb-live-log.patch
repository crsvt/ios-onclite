+	ou_wr(dwc, OU_GUSB3PIPECTL, usb_rd(dwc, OU_GUSB3PIPECTL) & ~(OU_U3_SUSPHY | OU_U3_DELAYP1TRANS));
+	printf(OU_TAG "GCTL 0x%08x GUSB2PHYCFG 0x%08x GUSB3PIPECTL 0x%08x\n",
+	    usb_rd(dwc, OU_GCTL), usb_rd(dwc, OU_GUSB2PHYCFG), usb_rd(dwc, OU_GUSB3PIPECTL));
+}
