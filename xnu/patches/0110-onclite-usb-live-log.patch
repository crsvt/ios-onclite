+	ou_wr(dwc, OU_GCTL, usb_rd(dwc, OU_GCTL) & ~OU_GCTL_CORESOFTRESET);
+	/* usb_wrapper_hsonly_mode: pipe interface clocked from UTMI, PHYSTATUS from software */
+	ou_wr(qs, QS_GENERAL_CFG, usb_rd(qs, QS_GENERAL_CFG) | QS_PIPE_UTMI_CLK_DIS);
+	delay(1);
