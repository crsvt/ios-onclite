+/* LK dwc_gctl_init (dwc_device_init step 16): device mode, no suspend, no clock gating. */
+static void
+onclite_dwc_gctl_init(vm_offset_t dwc)
+{
+	uint32_t gctl = usb_rd(dwc, OU_GCTL);
+	gctl &= ~(OU_GCTL_DEBUGATTACH | OU_GCTL_CORESOFTRESET | OU_GCTL_PRTCAPDIR | OU_GCTL_FRMSCLDWN |
+	    OU_GCTL_PWRDNSCALE | OU_GCTL_DSBLCLKGTNG);
