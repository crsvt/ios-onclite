diff --git a/bsd/dev/sweet_sample.c b/bsd/dev/sweet_sample.c
index b40eccd..977b457 100644
--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -18,10 +18,11 @@
 #include <sys/proc_internal.h>
 #include <kern/task.h>
 #include <kern/thread.h>
+#include <kern/clock.h>
+#include <kern/sched_prim.h>
 #include <pexpert/pexpert.h>
 
 extern task_t proc_task(proc_t);
-extern int hz;
 extern void sweet_sample_start(void);
 
 static char sweet_sample_names[128];
@@ -60,21 +61,36 @@ sweet_sample_proc(proc_t p, __unused void *arg)
 	return PROC_RETURNED;
 }
 
+/*
+ * Not tsleep(): on onclite a tsleep(90 * hz) here never returned (no sample
+ * in 10 minutes, E5), while assert_wait_deadline sleeps (onclite_touch.c,
+ * IOSleep) work.
+ */
 static void
-sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
+sweet_sample_sleep(unsigned int secs)
 {
 	static int chan;
+	uint64_t deadline;
+	clock_interval_to_deadline(secs, NSEC_PER_SEC, &deadline);
+	(void)assert_wait_deadline(&chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
+{
 	if (!PE_parse_boot_argn("sweetsample", sweet_sample_names, sizeof(sweet_sample_names))) {
 		strlcpy(sweet_sample_names, "SpringBoard,backboardd", sizeof(sweet_sample_names));
 	}
 	if (sweet_sample_names[0] == '-') {
 		return;
 	}
-	(void)tsleep(&chan, PZERO, "sweetsmp", 90 * hz);
+	printf("SMP sampler for %s: first sample in 90 s\n", sweet_sample_names);
+	sweet_sample_sleep(90);
 	for (int i = 0; i < 40; i++) {
 		printf("SMP --- sample %d\n", i);
 		proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, NULL, NULL, NULL);
-		(void)tsleep(&chan, PZERO, "sweetsmp", 120 * hz);
+		sweet_sample_sleep(120);
 	}
 }
 
