@@ -10,6 +10,250 @@
 #include <IOKit/IODeviceTreeSupport.h>
 #include <IOKit/IOLib.h>
 
+#if defined(ONCLITE)
+#include <machine/atomic.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+
+/*
+ * onclite: restart through PS_HOLD (DT qcom,pshold restart@4ab000). PSCI
+ * SYSTEM_RESET just returns on this TZ (shim tests); dropping PS_HOLD makes
+ * the PMIC reset the SoC with DRAM kept, so the ramoops console survives and
+ * LK boots Linux, where the record is /sys/fs/pstore/console-ramoops-0.
+ * Panics reach this with a debug= value without DB_NMI (0x4), e.g. 0x8.
+ * Boot-arg onclite_reboot_after=N restarts N seconds after the platform
+ * expert starts, for unattended tests.
+ *
+ * Before dropping PS_HOLD the boot mode for LK goes into the PM8953 PON
+ * register SOFT_RB_SPARE (0x88f, bits 7:2; LK USE_PON_REBOOT_REG: 1 recovery,
+ * 2 fastboot). Default recovery: once userdata holds the iOS root, a normal
+ * Android boot must never run (its fstab marks /data formattable). Boot-arg
+ * onclite_reset_to=normal|recovery|fastboot. The write is a polled SPMI
+ * command through the PMIC arbiter v2 (Linux spmi-pmic-arb.c), EE 0.
+ */
+#define ONCLITE_PSHOLD_PA       0x004ab000UL
+#define SPMI_CORE_PA            0x0200f000UL    /* reg-names core, chnls, obsrvr, cnfg */
+#define SPMI_CHNLS_PA           0x02400000UL
+#define SPMI_OBSRVR_PA          0x02c00000UL
+#define SPMI_CNFG_PA            0x0200a000UL
+#define SPMI_APID_MAP(n)        (0x800 + 4 * (n))
+#define SPMI_OWNER(n)           (0x700 + 4 * (n))
+#define SPMI_CMD                0x00
+#define SPMI_STATUS             0x08
+#define SPMI_WDATA0             0x10
+#define SPMI_RDATA0             0x18
+#define SPMI_OP_WRITEL          0u
+#define SPMI_OP_READL           1u
+#define PON_PPID                0x008           /* SID 0, peripheral 0x08 (PON) */
+#define PON_SOFT_RB_SPARE       0x8f
+#define PON_PS_HOLD_RESET_CTL   0x5a            /* [3:0] type: 1 warm, 7 hard, 8 DVDD hard (as left) */
+#define PON_PS_HOLD_RESET_CTL2  0x5b            /* bit 7: enable */
+#define PON_RESET_TYPE_WARM     1
+#define PON_RESET_EN            0x80
+#define LK_MODE_NORMAL          0
+#define LK_MODE_RECOVERY        1
+#define LK_MODE_FASTBOOT        2
+
+extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern "C" kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+
+static volatile uint32_t *onclite_pshold;
+static vm_offset_t onclite_spmi_chnl, onclite_spmi_obsrvr;     /* the PON channel's windows */
+static uint32_t onclite_reset_mode = LK_MODE_RECOVERY;
+
+static int
+onclite_spmi_wait(vm_offset_t window)
+{
+	for (int i = 0; i < 10000; i++) {
+		uint32_t st = *(volatile uint32_t *)(window + SPMI_STATUS);
+		if (st & 1) {
+			return (st & 0xe) ? (int)st : 0;   /* failure, denied, dropped */
+		}
+		IODelay(1);
+	}
+	return -1;
+}
+
+static int
+onclite_pon_read(uint8_t reg, uint8_t *value)
+{
+	if (!onclite_spmi_obsrvr) {
+		return -1;
+	}
+	*(volatile uint32_t *)(onclite_spmi_obsrvr + SPMI_CMD) = (SPMI_OP_READL << 27) | ((uint32_t)reg << 4);
+	int rc = onclite_spmi_wait(onclite_spmi_obsrvr);
+	if (!rc) {
+		*value = (uint8_t)*(volatile uint32_t *)(onclite_spmi_obsrvr + SPMI_RDATA0);
+	}
+	return rc;
+}
+
+static int
+onclite_pon_write(uint8_t reg, uint8_t value)
+{
+	if (!onclite_spmi_chnl) {
+		return -1;
+	}
+	*(volatile uint32_t *)(onclite_spmi_chnl + SPMI_WDATA0) = value;
+	*(volatile uint32_t *)(onclite_spmi_chnl + SPMI_CMD) = (SPMI_OP_WRITEL << 27) | ((uint32_t)reg << 4);
+	return onclite_spmi_wait(onclite_spmi_chnl);
+}
+
+/*
+ * PS_HOLD reset type warm, as Linux qpnp_pon_reset_config() does before a
+ * reboot with a reason: LK leaves DVDD hard reset (8), which does not keep
+ * SOFT_RB_SPARE for LK (C7: reset landed in Android). Disable, wait 10 sleep
+ * clock cycles, set the type, enable.
+ */
+static int
+onclite_pon_warm_reset(uint8_t *ctl_out)
+{
+	uint8_t ctl = 0;
+	int rc = onclite_pon_read(PON_PS_HOLD_RESET_CTL, &ctl);
+	if (!rc) {
+		rc = onclite_pon_write(PON_PS_HOLD_RESET_CTL2, 0);
+	}
+	if (!rc) {
+		IODelay(500);
+		rc = onclite_pon_write(PON_PS_HOLD_RESET_CTL, (uint8_t)((ctl & ~0xf) | PON_RESET_TYPE_WARM));
+	}
+	if (!rc) {
+		rc = onclite_pon_write(PON_PS_HOLD_RESET_CTL2, PON_RESET_EN);
+	}
+	if (!rc) {
+		rc = onclite_pon_read(PON_PS_HOLD_RESET_CTL, &ctl);
+	}
+	*ctl_out = ctl;
+	return rc;
+}
+
+/* Find the PON channel (apid) and map its write/read windows. */
+static void
+onclite_spmi_init(void)
+{
+	vm_offset_t core = ml_io_map(SPMI_CORE_PA, 0x1000);
+	vm_offset_t cnfg = ml_io_map(SPMI_CNFG_PA, 0x1000);
+	if (!core || !cnfg) {
+		return;
+	}
+	for (uint32_t apid = 0; SPMI_APID_MAP(apid) < 0x1000; apid++) {
+		uint32_t map = *(volatile uint32_t *)(core + SPMI_APID_MAP(apid));
+		if (map == 0 || ((map >> 8) & 0xfff) != PON_PPID) {
+			continue;
+		}
+		uint32_t owner = *(volatile uint32_t *)(cnfg + SPMI_OWNER(apid)) & 7;
+		IOLog("ONCLITE: SPMI PON is channel %u (owner EE %u)\n", apid, owner);
+		if (owner != 0) {
+			return;
+		}
+		onclite_spmi_chnl = ml_io_map(SPMI_CHNLS_PA + 0x8000 * apid, 0x1000);
+		onclite_spmi_obsrvr = ml_io_map(SPMI_OBSRVR_PA + 0x8000 * apid, 0x1000);
+		return;
+	}
+	IOLog("ONCLITE: SPMI PON channel not found\n");
+}
+
+/*
+ * Touch power check (read-only): print the state of PM8953 L6 (1.8 V, touch
+ * I/O and panel) and L10 (2.8 V, touch VDD), peripherals 0x45/0x49 on SID 1
+ * (LDOn at 0x4000 + (n - 1) * 0x100). Observer reads work for channels owned
+ * by any EE. STATUS1 0x08 bit 7 = VREG_READY, VSET 0x40/0x41, EN_CTL 0x46 bit 7.
+ */
+static void
+onclite_ldo_report(void)
+{
+	static const struct { const char *name; uint32_t ppid; } ldos[] = {
+		{ "L6", 0x145 }, { "L10", 0x149 },
+	};
+	vm_offset_t core = ml_io_map(SPMI_CORE_PA, 0x1000);
+	vm_offset_t cnfg = ml_io_map(SPMI_CNFG_PA, 0x1000);
+	if (!core || !cnfg) {
+		return;
+	}
+	for (unsigned i = 0; i < sizeof(ldos) / sizeof(ldos[0]); i++) {
+		uint32_t apid;
+		for (apid = 0; SPMI_APID_MAP(apid) < 0x1000; apid++) {
+			uint32_t map = *(volatile uint32_t *)(core + SPMI_APID_MAP(apid));
+			if (map != 0 && ((map >> 8) & 0xfff) == ldos[i].ppid) {
+				break;
+			}
+		}
+		if (SPMI_APID_MAP(apid) >= 0x1000) {
+			IOLog("ONCLITE: PMIC %s (ppid 0x%x): no SPMI channel\n", ldos[i].name, ldos[i].ppid);
+			continue;
+		}
+		vm_offset_t obs = ml_io_map(SPMI_OBSRVR_PA + 0x8000 * apid, 0x1000);
+		if (!obs) {
+			continue;
+		}
+		static const uint8_t regs[] = { 0x04, 0x05, 0x08, 0x40, 0x41, 0x45, 0x46 };
+		uint8_t val[sizeof(regs)] = { 0 };
+		int rc = 0;
+		for (unsigned r = 0; r < sizeof(regs) && !rc; r++) {
+			*(volatile uint32_t *)(obs + SPMI_CMD) = (SPMI_OP_READL << 27) | ((uint32_t)regs[r] << 4);
+			rc = onclite_spmi_wait(obs);
+			if (!rc) {
+				val[r] = (uint8_t)*(volatile uint32_t *)(obs + SPMI_RDATA0);
+			}
+		}
+		IOLog("ONCLITE: PMIC %s channel %u owner EE %u (spmi %d): type 0x%02x/0x%02x status1 0x%02x "
+		    "vset 0x%02x%02x mode 0x%02x en_ctl 0x%02x -> %s\n",
+		    ldos[i].name, apid, *(volatile uint32_t *)(cnfg + SPMI_OWNER(apid)) & 7, rc,
+		    val[0], val[1], val[2], val[4], val[3], val[5], val[6],
+		    rc ? "unknown" : ((val[2] & 0x80) ? "ON" : "OFF"));
+	}
+}
+
+static int
+onclite_halt_restart(unsigned int type)
+{
+	if (type == kPEPanicSync || type == kPEPanicDiagnosticsDone || type == kPEPanicBegin ||
+	    type == kPEPanicEnd || onclite_pshold == NULL) {
+		return 0;
+	}
+	uint8_t spare = 0, ctl = 0, check = 0;
+	int rc = 0;
+	if (onclite_reset_mode != LK_MODE_NORMAL) {
+		rc = onclite_pon_warm_reset(&ctl);
+		if (!rc) {
+			rc = onclite_pon_read(PON_SOFT_RB_SPARE, &spare);
+		}
+		if (!rc) {
+			rc = onclite_pon_write(PON_SOFT_RB_SPARE, (uint8_t)((spare & 3) | (onclite_reset_mode << 2)));
+		}
+		if (!rc) {
+			rc = onclite_pon_read(PON_SOFT_RB_SPARE, &check);
+		}
+	}
+	kprintf("ONCLITE: restart (type %u) via PS_HOLD, LK mode %u: reset ctl 0x%x, SOFT_RB_SPARE 0x%x -> 0x%x "
+	    "(spmi %d)\n", type, onclite_reset_mode, ctl, spare, check, rc);
+	__builtin_arm_dsb(DSB_SY);
+	*onclite_pshold = 0;
+	__builtin_arm_dsb(DSB_SY);
+	for (;;) {
+		__builtin_arm_wfe();
+	}
+}
+
+static void
+onclite_reboot_timer(void *arg, wait_result_t wr __unused)
+{
+	uint32_t secs = (uint32_t)(uintptr_t)arg;
+	/*
+	 * Sleep a minute at a time: a single IOSleep of 1800 s hung the boot
+	 * right after AppleCLCD twice (E3, E3b) while 480 s and 600 s worked
+	 * (ns * 19.2 MHz overflows 64 bits above ~960 s).
+	 */
+	for (uint32_t left = secs; left != 0;) {
+		uint32_t step = left > 60 ? 60 : left;
+		IOSleep(step * 1000);
+		left -= step;
+	}
+	IOLog("ONCLITE: onclite_reboot_after=%u expired, restarting\n", secs);
+	PEHaltRestart(kPERestartCPU);
+}
+#endif /* ONCLITE */
+
 class SweetPlatformExpert : public IODTPlatformExpert {
 	OSDeclareDefaultStructors(SweetPlatformExpert);
 
@@ -31,6 +275,31 @@ SweetPlatformExpert::start(IOService *provider)
 	}
 	registerService();
 	IOLog("SWEET: platform expert registered\n");
+#if defined(ONCLITE)
+	char mode[16] = "recovery";
+	PE_parse_boot_argn("onclite_reset_to", mode, sizeof(mode));
+	onclite_reset_mode = !strcmp(mode, "normal") ? LK_MODE_NORMAL :
+	    !strcmp(mode, "fastboot") ? LK_MODE_FASTBOOT : LK_MODE_RECOVERY;
+	onclite_spmi_init();
+	onclite_ldo_report();
+	uint8_t spare = 0;
+	int spmi_rc = onclite_pon_read(PON_SOFT_RB_SPARE, &spare);
+	IOLog("ONCLITE: PON SOFT_RB_SPARE 0x%x (spmi %d), restarts go to LK mode %u\n",
+	    spare, spmi_rc, onclite_reset_mode);
+	onclite_pshold = (volatile uint32_t *)ml_io_map(ONCLITE_PSHOLD_PA, PAGE_SIZE);
+	if (onclite_pshold != NULL) {
+		PE_halt_restart = onclite_halt_restart;
+	}
+	uint32_t secs = 0;
+	if (PE_parse_boot_argn("onclite_reboot_after", &secs, sizeof(secs)) && secs != 0) {
+		thread_t thread;
+		if (kernel_thread_start(onclite_reboot_timer, (void *)(uintptr_t)secs, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		}
+	}
+	IOLog("ONCLITE: restart via PS_HOLD %s, reboot timer %u s\n",
+	    onclite_pshold != NULL ? "ready" : "UNAVAILABLE", secs);
+#endif
 	return true;
 }
 
