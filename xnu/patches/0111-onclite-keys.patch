diff --git a/bsd/dev/onclite_keys.c b/bsd/dev/onclite_keys.c
new file mode 100644
index 0000000..3f37c49
--- /dev/null
+++ b/bsd/dev/onclite_keys.c
@@ -0,0 +1,146 @@
+/*
+ * onclite buttons: power and volume down on the PM8953 PON block, volume
+ * up on TLMM GPIO 85 (live DT: qcom,power-on@800 pon_1 KEY_POWER /
+ * pon_2 KEY_VOLUMEDOWN, gpio_keys/vol_up gpios = <tlmm 85 active-low>).
+ *
+ * PON_RT_STS (0x810) is read through the SPMI arbiter v2 observer channel
+ * of the PON peripheral (read-only, any owner), as SweetPlatformExpert.cpp
+ * does for the restart registers; GPIO 85 is the TLMM input level. Polled
+ * every 20 ms; changes go to SweetHIDButtons through sweet_hid_key()
+ * (0 power, 1 volume up, 2 volume down). Boot-arg onclitekeys=0 disables it.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(ONCLITE)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+/* osfmk/arm/machine_routines.h, not exported to the BSD layer */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern void sweet_hid_key(int key, int down);
+void onclite_keys_init(void);
+
+#define SPMI_CORE_PA            0x0200f000u
+#define SPMI_APID_MAP(n)        (0x800u + 4u * (n))
+#define SPMI_OBSRVR_PA          0x02c00000u
+#define SPMI_CMD                0x00
+#define SPMI_STATUS             0x08
+#define SPMI_RDATA0             0x18
+#define SPMI_OP_READL           1u
+#define PON_PPID                0x008u          /* SID 0, peripheral 0x08 */
+#define PON_RT_STS              0x10u           /* bit 0 KPDPWR, bit 1 RESIN */
+
+#define TLMM_PA                 0x01000000u
+#define GPIO_VOL_UP             85u
+#define TLMM_PIN_PA(n)          (TLMM_PA + (n) * 0x1000u)  /* CFG at +0, IN_OUT at +4 */
+
+static vm_offset_t keys_pon, keys_volup;  /* PON observer window, GPIO 85 registers */
+static bool keys_started;
+static int keys_sleep_chan;
+
+static bool
+keys_pon_read(uint8_t *out)
+{
+	*(volatile uint32_t *)(keys_pon + SPMI_CMD) = (SPMI_OP_READL << 27) | (PON_RT_STS << 4);
+	__asm__ volatile ("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; i++) {
+		uint32_t st = *(volatile uint32_t *)(keys_pon + SPMI_STATUS);
+		if (st & 1u) {
+			if (st & 0x0eu) {
+				return false;   /* failure, denied, dropped */
+			}
+			*out = (uint8_t)*(volatile uint32_t *)(keys_pon + SPMI_RDATA0);
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+keys_wait(void)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(20, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&keys_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+keys_thread(__unused void *arg, __unused wait_result_t result)
+{
+	int state[3] = {0, 0, 0};
+	unsigned errors = 0;
+	for (;;) {
+		uint8_t pon = 0;
+		bool pok = keys_pon_read(&pon);
+		uint32_t io = *(volatile uint32_t *)(keys_volup + 4);
+		int now[3] = { !!(pon & 1u), !(io & 1u), !!(pon & 2u) };
+		if (!pok && (errors++ % 250u) == 0) {
+			printf("ONCLITE KEYS: PON read error\n");
+		}
+		for (int k = 0; k < 3; k++) {
+			if ((k == 1 || pok) && now[k] != state[k]) {
+				state[k] = now[k];
+				printf("ONCLITE KEYS: key %d down %d (pon 0x%x gpio85 0x%x)\n", k, state[k], pon, io);
+				sweet_hid_key(k, state[k]);
+			}
+		}
+		keys_wait();
+	}
+}
+
+void
+onclite_keys_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	if (keys_started) {
+		return;
+	}
+	keys_started = true;
+	(void)PE_parse_boot_argn("onclitekeys", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("ONCLITE KEYS: disabled (onclitekeys=0)\n");
+		return;
+	}
+	vm_offset_t core = ml_io_map(SPMI_CORE_PA, 0x1000);
+	keys_volup = ml_io_map(TLMM_PIN_PA(GPIO_VOL_UP), 0x1000);
+	if (!core || !keys_volup) {
+		printf("ONCLITE KEYS: MMIO mapping failed\n");
+		return;
+	}
+	uint32_t apid;
+	for (apid = 0; SPMI_APID_MAP(apid) < 0x1000u; apid++) {
+		uint32_t map = *(volatile uint32_t *)(core + SPMI_APID_MAP(apid));
+		if (map != 0 && ((map >> 8) & 0xfffu) == PON_PPID) {
+			break;
+		}
+	}
+	if (SPMI_APID_MAP(apid) >= 0x1000u) {
+		printf("ONCLITE KEYS: SPMI PON channel not found\n");
+		return;
+	}
+	keys_pon = ml_io_map(SPMI_OBSRVR_PA + 0x8000u * apid, 0x1000);
+	if (!keys_pon) {
+		printf("ONCLITE KEYS: PON observer mapping failed\n");
+		return;
+	}
+	/* GPIO 85: GPIO function, input, pull-up (the key pulls it low). */
+	vm_offset_t cfg = keys_volup;
+	*(volatile uint32_t *)cfg = (*(volatile uint32_t *)cfg & ~0x3ffu) | 0x3u | (1u << 6);
+	__asm__ volatile ("dsb osh" ::: "memory");
+	printf("ONCLITE KEYS: PON channel %u, GPIO 85 cfg 0x%x; polling every 20 ms\n",
+	    apid, *(volatile uint32_t *)cfg);
+	if (kernel_thread_start(keys_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("ONCLITE KEYS: kernel_thread_start failed\n");
+	}
+}
+#endif /* ONCLITE */
