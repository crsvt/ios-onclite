diff --git a/osfmk/arm64/onclite_lse.c b/osfmk/arm64/onclite_lse.c
new file mode 100644
index 0000000..88883d5
--- /dev/null
+++ b/osfmk/arm64/onclite_lse.c
@@ -0,0 +1,236 @@
+/*
+ * onclite: EL0 emulation of the ARMv8.1 LSE atomics (and ARMv8.3 LDAPR).
+ *
+ * Kryo 250 is ARMv8.0. The iPhone X iOS 16 userland mostly selects its LSE
+ * code at run time ($VARIANT$armv81, from the commpage capabilities xnu
+ * derives from ID_AA64ISAR0), but about 400 instructions in libdispatch,
+ * libsystem_pthread, libsystem_platform, libsystem_malloc and a few
+ * frameworks use them unconditionally (NOTES.md, dyld cache scan). They
+ * arrive here as undefined instructions (ESR EC 0) and are emulated with
+ * the user-memory compare-and-swap in copyio.c. Every LD<op>/SWP is a
+ * compare-and-swap loop, which is as atomic as the instruction it replaces;
+ * the ordering is at least that of the acquire+release variants.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(ONCLITE)
+#include <mach/arm/thread_status.h>
+#include <arm64/proc_reg.h>
+#include <kern/misc_protos.h>
+#include <pexpert/pexpert.h>
+#include <machine/atomic.h>
+#include <sys/errno.h>
+#include <arm/cpu_data_internal.h>
+#include <kern/clock.h>
+#include <kern/cpu_number.h>
+
+extern int onclite_copy_cas(user_addr_t user_addr, unsigned int size_log2, uint64_t expected,
+    uint64_t desired, uint64_t *old);
+extern int onclite_copy_casp(user_addr_t user_addr, unsigned int size_log2, const uint64_t expected[2],
+    const uint64_t desired[2], uint64_t old[2]);
+extern int copyin_atomic32(const user_addr_t user_addr, uint32_t *kernel_addr);
+extern int copyin_atomic64(const user_addr_t user_addr, uint64_t *kernel_addr);
+extern int proc_selfpid(void);
+
+boolean_t onclite_emulate_lse(arm_saved_state_t *state, uint32_t instr);
+
+static uint64_t _Atomic onclite_lse_count;
+
+/* Emulated instructions so far (printed by bsd/dev/sweet_sample.c). */
+uint64_t onclite_lse_emulated(void);
+uint64_t
+onclite_lse_emulated(void)
+{
+	return os_atomic_load(&onclite_lse_count, relaxed);
+}
+
+/* Rs/Rt/Rs+1 as data: register 31 is XZR. */
+static uint64_t
+reg_or_zr(const arm_saved_state_t *state, unsigned int r)
+{
+	return r == 31 ? 0 : (uint64_t)get_saved_state_reg(state, r);
+}
+
+static void
+set_reg_or_zr(arm_saved_state_t *state, unsigned int r, uint64_t value)
+{
+	if (r != 31) {
+		set_saved_state_reg(state, r, (register_t)value);
+	}
+}
+
+static int64_t
+sext(uint64_t v, unsigned int size_log2)
+{
+	unsigned int shift = 64 - (8u << size_log2);
+	return (int64_t)(v << shift) >> shift;
+}
+
+static uint64_t
+lse_op(unsigned int opc, uint64_t cur, uint64_t v, unsigned int size_log2)
+{
+	switch (opc) {
+	case 0: return cur + v;                                         /* LDADD */
+	case 1: return cur & ~v;                                        /* LDCLR */
+	case 2: return cur ^ v;                                         /* LDEOR */
+	case 3: return cur | v;                                         /* LDSET */
+	case 4: return sext(cur, size_log2) > sext(v, size_log2) ? cur : v;  /* LDSMAX */
+	case 5: return sext(cur, size_log2) < sext(v, size_log2) ? cur : v;  /* LDSMIN */
+	case 6: return cur > v ? cur : v;                               /* LDUMAX */
+	default: return cur < v ? cur : v;                              /* LDUMIN */
+	}
+}
+
+/* LDAPR{B,H,}: the aligned word holding a byte or halfword is read atomically. */
+static int
+load_acquire(user_addr_t addr, unsigned int size_log2, uint64_t *out)
+{
+	int error;
+
+	if (size_log2 == 3) {
+		error = copyin_atomic64(addr, out);
+	} else if (addr & ((1u << size_log2) - 1)) {
+		error = EINVAL;
+	} else {
+		uint32_t word;
+		error = copyin_atomic32(addr & ~3ULL, &word);
+		if (!error) {
+			unsigned int shift = (unsigned int)(addr & 3) * 8;
+			uint64_t mask = size_log2 == 2 ? 0xffffffffULL : (1ULL << (8u << size_log2)) - 1;
+			*out = (word >> shift) & mask;
+		}
+	}
+	__builtin_arm_dmb(DMB_ISH);
+	return error;
+}
+
+/*
+ * Emulate one EL0 AArch64 instruction if it is an LSE atomic or LDAPR.
+ * Returns TRUE with the registers and PC updated; FALSE leaves everything
+ * unchanged (unknown instruction, unaligned or bad address) and the caller
+ * raises the usual EXC_BAD_INSTRUCTION.
+ */
+boolean_t
+onclite_emulate_lse(arm_saved_state_t *state, uint32_t instr)
+{
+	unsigned int rs = (instr >> 16) & 31, rn = (instr >> 5) & 31, rt = instr & 31;
+	unsigned int size = instr >> 30;
+	uint64_t mask = size == 3 ? ~0ULL : (1ULL << (8u << size)) - 1;
+	/* Rn is the base register: 31 is SP. */
+	user_addr_t addr = (user_addr_t)(rn == 31 ? get_saved_state_sp(state) : get_saved_state_reg(state, rn));
+	uint64_t cur, seen;
+
+	if ((instr & 0x3fa07c00) == 0x08a07c00) {
+		/* CAS{,A,L,AL}{B,H,}: Rs = expected in, old value out; Rt = new */
+		if (onclite_copy_cas(addr, size, reg_or_zr(state, rs) & mask,
+		    reg_or_zr(state, rt) & mask, &cur)) {
+			return FALSE;
+		}
+		set_reg_or_zr(state, rs, cur);
+	} else if ((instr & 0xbfa07c00) == 0x08207c00) {
+		/* CASP{,A,L,AL}: even register pairs Rs:Rs+1 and Rt:Rt+1 */
+		unsigned int psize = (instr & (1u << 30)) ? 3 : 2;
+		uint64_t pmask = psize == 3 ? ~0ULL : 0xffffffffULL;
+		uint64_t expected[2], desired[2], old[2];
+
+		if ((rs & 1) || (rt & 1)) {
+			return FALSE;
+		}
+		expected[0] = reg_or_zr(state, rs) & pmask;
+		expected[1] = reg_or_zr(state, rs + 1) & pmask;
+		desired[0] = reg_or_zr(state, rt) & pmask;
+		desired[1] = reg_or_zr(state, rt + 1) & pmask;
+		if (onclite_copy_casp(addr, psize, expected, desired, old)) {
+			return FALSE;
+		}
+		set_reg_or_zr(state, rs, old[0]);
+		set_reg_or_zr(state, rs + 1, old[1]);
+	} else if ((instr & 0x3f200c00) == 0x38200000) {
+		/* size 111 0 00 A R 1 Rs o3 opc 00 Rn Rt */
+		unsigned int o3 = (instr >> 15) & 1, opc = (instr >> 12) & 7;
+
+		if (o3 && opc == 4) {
+			/* LDAPR{B,H,}: Rs must be 31 */
+			if (rs != 31 || load_acquire(addr, size, &cur)) {
+				return FALSE;
+			}
+		} else if (o3 && opc != 0) {
+			return FALSE;
+		} else {
+			/* LD<op>/ST<op> (Rt = 31) and SWP: CAS loop from an atomic read */
+			uint64_t v = reg_or_zr(state, rs) & mask;
+			if (onclite_copy_cas(addr, size, 0, 0, &cur)) {
+				return FALSE;
+			}
+			for (;;) {
+				uint64_t next = o3 ? v : (lse_op(opc, cur, v, size) & mask);
+				if (onclite_copy_cas(addr, size, cur, next, &seen)) {
+					return FALSE;
+				}
+				if (seen == cur) {
+					break;
+				}
+				cur = seen;
+			}
+		}
+		/* Loaded value, zero-extended (W or X destination) */
+		set_reg_or_zr(state, rt, cur);
+	} else {
+		return FALSE;
+	}
+
+	add_saved_state_pc(state, 4);
+	uint64_t n = os_atomic_inc(&onclite_lse_count, relaxed);
+	if (n <= 8 || (n & (n - 1)) == 0) {
+		kprintf("ONCLITE LSE: emulated %llu instructions (pid %d, pc 0x%llx, instr 0x%08x)\n",
+		    n, proc_selfpid(), (uint64_t)get_saved_state_pc(state) - 4, instr);
+	}
+	return TRUE;
+}
+
+/*
+ * One diagnostics line per sampler snapshot (bsd/dev/sweet_sample.c), to
+ * measure instead of guess why userland is slow: core clock (a dependent
+ * add chain, 1 cycle per add on Cortex-A73, against the 19.2 MHz counter),
+ * per-core timer/IRQ/IPI counts, VM page counts, eMMC totals, LSE traps.
+ */
+extern unsigned int vm_page_free_count, vm_page_active_count, vm_page_inactive_count, vm_page_wire_count;
+extern uint32_t c_segment_pages_compressed;
+extern void onclite_emmc_stats(uint64_t *reads, uint64_t *rbytes, uint64_t *writes, uint64_t *wbytes, uint64_t *busy);
+void onclite_diag_print(void);
+
+void
+onclite_diag_print(void)
+{
+	uint64_t x = 0, abs;
+	boolean_t istate = ml_set_interrupts_enabled(FALSE);
+	int cpu = cpu_number();
+	uint64_t t0 = mach_absolute_time();
+	for (uint64_t i = 0; i < 20000000; i++) {
+		__asm__ volatile ("add %0, %0, #1" : "+r"(x));
+	}
+	abs = mach_absolute_time() - t0;
+	ml_set_interrupts_enabled(istate);
+	uint64_t ns;
+	absolutetime_to_nanoseconds(abs, &ns);
+	printf("DIAG cpu%d clock ~%llu MHz (20M adds in %llu us); LSE emulated %llu\n",
+	    cpu, ns ? 20000000ULL * 1000ULL / ns : 0, ns / 1000, onclite_lse_emulated());
+	for (int i = 0; i <= ml_get_max_cpu_number(); i++) {
+		cpu_data_t *cdp = cpu_datap(i);
+		if (cdp == NULL) {
+			continue;
+		}
+		printf("DIAG cpu%d timer %llu irq %llu ipi %llu\n", i, cdp->cpu_stat.timer_cnt,
+		    cdp->cpu_stat.irq_ex_cnt, cdp->cpu_stat.ipi_cnt);
+	}
+	printf("DIAG vm pages free %u active %u inactive %u wired %u compressed %u (16K pages)\n",
+	    vm_page_free_count, vm_page_active_count, vm_page_inactive_count, vm_page_wire_count,
+	    c_segment_pages_compressed);
+	uint64_t r, rb, w, wb, busy, busy_ns;
+	onclite_emmc_stats(&r, &rb, &w, &wb, &busy);
+	absolutetime_to_nanoseconds(busy, &busy_ns);
+	printf("DIAG emmc reads %llu (%llu KiB) writes %llu (%llu KiB) busy %llu ms -> %llu KiB/s while busy\n",
+	    r, rb >> 10, w, wb >> 10, busy_ns / 1000000,
+	    busy_ns ? (rb + wb) * 1000000000ULL / busy_ns / 1024 : 0);
+}
+#endif /* ONCLITE */
