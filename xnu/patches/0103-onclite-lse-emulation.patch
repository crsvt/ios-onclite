+#if defined(ONCLITE)
+extern int _onclite_user_cas8(user_addr_t, uint64_t, uint64_t, uint64_t *);
+extern int _onclite_user_cas16(user_addr_t, uint64_t, uint64_t, uint64_t *);
+extern int _onclite_user_cas32(user_addr_t, uint64_t, uint64_t, uint64_t *);
+extern int _onclite_user_cas64(user_addr_t, uint64_t, uint64_t, uint64_t *);
+extern int _onclite_user_casp32(user_addr_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t *);
+extern int _onclite_user_casp64(user_addr_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t *);
+
+/*
+ * onclite: single-copy atomic operations on user memory for the EL0
+ * emulation of ARMv8.1 LSE instructions (osfmk/arm64/onclite_lse.c).
+ * size_log2 0-3 (byte to doubleword); operands are already truncated.
+ * Returns 0, EFAULT, or EINVAL for an unaligned address.
+ */
+int
+onclite_copy_cas(user_addr_t user_addr, unsigned int size_log2, uint64_t expected,
+    uint64_t desired, uint64_t *old)
+{
+	int result = copy_validate(user_addr, 0, 1UL << size_log2,
+	    COPYIO_OUT | COPYIO_ATOMIC | COPYIO_VALIDATE_USER_ONLY);
+	if (__improbable(result)) {
+		return result;
+	}
+	user_access_enable();
+	switch (size_log2) {
+	case 0:
+		result = _onclite_user_cas8(user_addr, expected, desired, old);
+		break;
+	case 1:
+		result = _onclite_user_cas16(user_addr, expected, desired, old);
+		break;
+	case 2:
+		result = _onclite_user_cas32(user_addr, expected, desired, old);
+		break;
+	default:
+		result = _onclite_user_cas64(user_addr, expected, desired, old);
+		break;
+	}
+	user_access_disable();
+	return result;
+}
+
+/* CASP: a pair of words (size_log2 2) or doublewords (3), naturally aligned as a pair. */
+int
+onclite_copy_casp(user_addr_t user_addr, unsigned int size_log2, const uint64_t expected[2],
+    const uint64_t desired[2], uint64_t old[2])
+{
+	int result = copy_validate(user_addr, 0, 2UL << size_log2,
+	    COPYIO_OUT | COPYIO_ATOMIC | COPYIO_VALIDATE_USER_ONLY);
+	if (__improbable(result)) {
+		return result;
+	}
+	user_access_enable();
+	if (size_log2 == 2) {
+		result = _onclite_user_casp32(user_addr, expected[0], expected[1], desired[0], desired[1], old);
+	} else {
+		result = _onclite_user_casp64(user_addr, expected[0], expected[1], desired[0], desired[1], old);
+	}
+	user_access_disable();
+	return result;
+}
+#endif /* ONCLITE */
+
