+#if defined(ONCLITE)
+/*
+ * onclite: user-memory compare-and-swap for the EL0 emulation of ARMv8.1
+ * LSE atomics (osfmk/arm64/onclite_lse.c). Kryo 250 is ARMv8.0; the iOS 16
+ * userland executes CAS/LD<op>/SWP unconditionally in a few hundred places.
+ *
+ * int _onclite_user_cas{8,16,32,64}(user_addr_t addr, uint64_t expected,
+ *                                   uint64_t desired, uint64_t *old)
+ *	*old = the value read (zero-extended); memory = desired iff it was
+ *	expected. expected/desired are already truncated to the size.
+ * int _onclite_user_casp{32,64}(user_addr_t addr, uint64_t exp_lo, uint64_t exp_hi,
+ *                               uint64_t des_lo, uint64_t des_hi, uint64_t old[2])
+ *
+ * LDAXR/STLXR followed by DMB ISH is at least as strong as every CAS ordering
+ * variant. A page fault inside the range is resolved by the VM first and only
+ * an unresolvable one returns EFAULT; a fault between LDAXR and STLXR clears
+ * the monitor and the loop retries.
+ */
+.macro ONCLITE_USER_CAS name, ldx, stx, val, exp, des
+	.text
+	.align 2
+	.globl EXT(\name)
+LEXT(\name)
+	ARM64_STACK_PROLOG
+	PUSH_FRAME
+	COPYIO_RECOVER_RANGE 3f
+1:
+	\ldx	\val, [x0]
+	cmp		\val, \exp
+	b.ne	2f
+	\stx	w9, \des, [x0]
+	cbnz	w9, 1b
+	b		3f
+2:
+	clrex
+3:
+	dmb		ish
+	str		x8, [x3]
+	mov		x0, #0
+	POP_FRAME
+	ARM64_STACK_EPILOG
+.endmacro
+
+	ONCLITE_USER_CAS _onclite_user_cas8, ldaxrb, stlxrb, w8, w1, w2
+	ONCLITE_USER_CAS _onclite_user_cas16, ldaxrh, stlxrh, w8, w1, w2
+	ONCLITE_USER_CAS _onclite_user_cas32, ldaxr, stlxr, w8, w1, w2
+	ONCLITE_USER_CAS _onclite_user_cas64, ldaxr, stlxr, x8, x1, x2
+
+/*
+ * A pair read by LDAXP is single-copy atomic only together with a successful
+ * STLXP, so a mismatch writes the old pair back instead of CLREX.
+ */
+.macro ONCLITE_USER_CASP name, lo, hi, exp_lo, exp_hi, des_lo, des_hi
+	.text
+	.align 2
+	.globl EXT(\name)
+LEXT(\name)
+	ARM64_STACK_PROLOG
+	PUSH_FRAME
+	COPYIO_RECOVER_RANGE 3f
+1:
+	ldaxp	\lo, \hi, [x0]
+	cmp		\lo, \exp_lo
+	ccmp	\hi, \exp_hi, #0, eq
+	b.ne	2f
+	stlxp	w10, \des_lo, \des_hi, [x0]
+	cbnz	w10, 1b
+	b		3f
+2:
+	stlxp	w10, \lo, \hi, [x0]
+	cbnz	w10, 1b
+3:
+	dmb		ish
+	stp		x8, x9, [x5]
+	mov		x0, #0
+	POP_FRAME
+	ARM64_STACK_EPILOG
+.endmacro
+
+	ONCLITE_USER_CASP _onclite_user_casp32, w8, w9, w1, w2, w3, w4
+	ONCLITE_USER_CASP _onclite_user_casp64, x8, x9, x1, x2, x3, x4
+#endif /* ONCLITE */
