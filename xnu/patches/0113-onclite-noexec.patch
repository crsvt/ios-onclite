diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index 68612db..9d4b89f 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -2128,6 +2128,43 @@ struct execsw {
  *	<ex_imgact>:???			[anything an imgact can return]
  *	EDEADLK				Process is being terminated
  */
+#if defined(ONCLITE)
+/*
+ * Daemons for hardware the Redmi 7 port has no driver for crash at once and
+ * launchd restarts them: H9 had 53 bluetoothd and 54 fairplayd.H2 launches in
+ * 12 minutes at 800 MHz (plus vmd burning a core). Refuse to exec the ones
+ * named in boot-arg onclite_noexec (comma list, "-" = none) so launchd backs
+ * off instead.
+ */
+static char onclite_noexec_names[128];
+static int onclite_noexec_ready;
+
+static bool
+onclite_exec_blocked(const char *name)
+{
+	if (!onclite_noexec_ready) {
+		if (!PE_parse_boot_argn("onclite_noexec", onclite_noexec_names, sizeof(onclite_noexec_names))) {
+			strlcpy(onclite_noexec_names, "bluetoothd,fairplayd.H2,vmd", sizeof(onclite_noexec_names));
+		}
+		onclite_noexec_ready = 1;
+	}
+	size_t n = strlen(name);
+	for (const char *t = onclite_noexec_names; n > 0 && *t && *t != '-';) {
+		const char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+		if (tl == n && strncmp(t, name, n) == 0) {
+			printf("exec %s refused (onclite_noexec)\n", name);
+			return true;
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+	return false;
+}
+#endif /* ONCLITE */
+
 static int
 exec_activate_image(struct image_params *imgp)
 {
@@ -7414,6 +7451,14 @@ process_signature(proc_t p, struct image_params *imgp)
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 			/* SWEET runs every iOS binary this way: one short line per exec. */
 			printf("exec %s\n", p->p_name);
+#if defined(ONCLITE)
+			if (onclite_exec_blocked(p->p_name)) {
+				signature_failure_reason = os_reason_create(OS_REASON_EXEC,
+				    EXEC_EXIT_REASON_WRONG_PLATFORM);
+				error = EACCES;
+				goto done;
+			}
+#endif
 #else
 			printf("Allowing spawn of iOS binary %s since it has "
 			    "com.apple.private.security.no-sandbox entitlement or unentitled_ios_sim_launch "
