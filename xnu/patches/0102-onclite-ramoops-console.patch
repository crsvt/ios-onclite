diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 6928957..ea3813d 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -7,7 +7,137 @@
  */
 #include <arm64/sweet_early.h>
 
-#if defined(SWEET)
+#if defined(ONCLITE)
+#include <stdint.h>
+#include <kern/misc_protos.h>
+#include <machine/atomic.h>
+
+/*
+ * Redmi 7 console: LK switches the panel off for `fastboot boot`, so the
+ * console goes into the ramoops console zone instead (DT ramoops@91400000,
+ * console-size 2M, no dump zones; fs/pstore/ram_core.c layout). The next
+ * Linux boot shows it as /sys/fs/pstore/console-ramoops-0. The shim logs
+ * there first; xnu continues its record.
+ *
+ * start.s maps the 32MB block holding splash and ramoops VA=PA as Normal
+ * Non-Cacheable; arm_vm_init moves it to a reserved kernel VA. The same
+ * writer backs the early marks, the early panic hook and the "serial"
+ * device in pexpert/arm/pe_serial.c, so it stays enabled for the whole boot.
+ */
+#define PLOG_BLOCK_PA   0x90000000ULL
+#define PLOG_PA         0x91400000ULL
+#define PLOG_ZONE_SIZE  0x200000u
+#define PLOG_SIG        0x43474244u     /* "DBGC" */
+
+struct plog_header {
+	uint32_t sig;
+	uint32_t start;         /* next write position in data[] */
+	uint32_t size;          /* valid bytes, up to PLOG_CAP */
+	uint8_t data[];
+};
+#define PLOG_CAP        (PLOG_ZONE_SIZE - (uint32_t)sizeof(struct plog_header))
+
+static volatile struct plog_header *plog = (volatile struct plog_header *)(uintptr_t)PLOG_PA;
+static uint64_t _Atomic plog_total;     /* bytes ever written, including the shim's */
+static unsigned int plog_started, early_disabled, early_panicking;
+
+static void
+plog_start(void)
+{
+	plog_started = 1;
+	/* Continue an unwrapped record (the shim's); anything else starts over. */
+	if (plog->sig == PLOG_SIG && plog->size <= PLOG_CAP && plog->start == plog->size) {
+		os_atomic_store(&plog_total, (uint64_t)plog->size, relaxed);
+	} else {
+		plog->sig = PLOG_SIG;
+		plog->start = 0;
+		plog->size = 0;
+		os_atomic_store(&plog_total, 0, relaxed);
+	}
+}
+
+void
+onclite_plog_putc(char c)
+{
+	if (c == '\r') {
+		return;
+	}
+	if (!plog_started) {
+		plog_start();
+	}
+	uint64_t at = os_atomic_inc_orig(&plog_total, relaxed);
+	plog->data[at % PLOG_CAP] = (uint8_t)c;
+	plog->start = (uint32_t)((at + 1) % PLOG_CAP);
+	plog->size = (at + 1 < PLOG_CAP) ? (uint32_t)(at + 1) : PLOG_CAP;
+	if (c == '\n') {
+		/* Normal-NC: drain the write buffer, a reset may follow any line. */
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+}
+
+void
+sweet_early_putc(char c)
+{
+	onclite_plog_putc(c);
+}
+
+static void
+sweet_early_string(const char *s)
+{
+	while (*s) {
+		onclite_plog_putc(*s++);
+	}
+}
+
+void
+sweet_early_mark(unsigned int stage, const char *label)
+{
+	if (early_disabled || stage > 20) {
+		return;
+	}
+	sweet_early_string("ONCLITE EARLY ");
+	if (stage >= 10) {
+		onclite_plog_putc((char)('0' + stage / 10));
+	}
+	onclite_plog_putc((char)('0' + stage % 10));
+	sweet_early_string(": ");
+	sweet_early_string(label);
+	onclite_plog_putc('\n');
+}
+
+void
+sweet_early_panic(const char *fmt, va_list *args)
+{
+	if (early_disabled || early_panicking) {
+		return;
+	}
+	early_panicking = 1;
+	sweet_early_string("\nONCLITE EARLY PANIC: ");
+	va_list copy;
+	va_copy(copy, *args);
+	_doprnt(fmt, &copy, sweet_early_putc, 16);
+	va_end(copy);
+	onclite_plog_putc('\n');
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
+sweet_early_relocate(uint64_t base)
+{
+	sweet_early_mark(8, "leaving bootstrap TTBR0");
+	plog = (volatile struct plog_header *)(uintptr_t)(base + (PLOG_PA - PLOG_BLOCK_PA));
+	__asm__ volatile("dsb sy" ::: "memory");
+	sweet_early_mark(9, "kernel ramoops VA live");
+}
+
+/* After serial_init the pe_serial device carries the console: no more marks. */
+void
+sweet_early_disable(void)
+{
+	early_disabled = 1;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+#elif defined(SWEET)
 #include <stdint.h>
 #include <kern/misc_protos.h>
 
@@ -140,4 +270,4 @@ sweet_early_disable(void)
 	early_disabled = 1;
 	__asm__ volatile("dsb sy" ::: "memory");
 }
-#endif /* SWEET */
+#endif /* ONCLITE / SWEET */
