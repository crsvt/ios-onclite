diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 6089db9..043eea1 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -222,6 +222,154 @@ pe_init_fiq()
 	__builtin_arm_isb(ISB_SY);
 #endif /* SWEET */
 }
+#elif HAS_GIC_V2
+/*
+ * onclite: GICv2 (QGIC2) with security extensions. TrustZone owns Group 0;
+ * the timer and SGIs are Group 1 non-secure and arrive as IRQs (sleh_irq).
+ * The CPU interface is memory-mapped and banked per core; it starts
+ * disabled on every core the shim or PSCI CPU_ON brings up.
+ */
+SECURITY_READ_ONLY_LATE(uint32_t) sweet_vtimer_intid = SWEET_VTIMER_INTID;
+
+static vm_offset_t gicd_base;
+static vm_offset_t gicc_base;
+
+/* GICv2 CPU interface number of each logical CPU (one bit of GICD_ITARGETSR). */
+static uint8_t gic_cpu_iface_mask[MAX_CPUS];
+
+static uint32_t
+_gic_read32(vm_offset_t addr)
+{
+	return *((volatile uint32_t *) addr);
+}
+
+static void
+_gic_write32(vm_offset_t addr, uint32_t value)
+{
+	*((volatile uint32_t *) addr) = value;
+}
+
+static void
+_gic_write8(vm_offset_t addr, uint8_t value)
+{
+	*((volatile uint8_t *) addr) = value;
+}
+
+#define gicd_read32(offset) (_gic_read32(gicd_base + (offset)))
+#define gicd_write32(offset, data) (_gic_write32(gicd_base + (offset), (data)))
+#define gicc_read32(offset) (_gic_read32(gicc_base + (offset)))
+#define gicc_write32(offset, data) (_gic_write32(gicc_base + (offset), (data)))
+
+void
+pe_init_fiq()
+{
+	int error;
+	DTEntry entry;
+
+	// gicd_base is 0x0 only before it's initialized by the boot processor.
+	// Avoid calling SecureDT* routines on secondary processors to avoid
+	// race conditions because they are not thread-safe.
+	if (!gicd_base) {
+		error = SecureDTLookupEntry(NULL, "/arm-io/gic", &entry);
+		if (error != kSuccess) {
+			panic("%s: cannot find GIC node in DT", __func__);
+		}
+
+		// reg = <GICD base, GICD size, GICC base, GICC size>
+		void const *prop;
+		unsigned int prop_size;
+		error = SecureDTGetProperty(entry, "reg", &prop, &prop_size);
+		if (error != kSuccess) {
+			panic("%s: cannot find GIC MMIO regions in DT", __func__);
+		}
+		if (prop_size < 4 * sizeof(uint64_t)) {
+			panic("%s: incorrect reg property size in GIC DT node; expecting 32 bytes but got %u bytes", __func__, prop_size);
+		}
+
+		void const *timer_prop;
+		unsigned int timer_size;
+		if (SecureDTGetProperty(entry, "virtual-timer-intid", &timer_prop, &timer_size) == kSuccess) {
+			if (timer_size != sizeof(uint32_t)) {
+				panic("%s: invalid virtual-timer-intid size %u", __func__, timer_size);
+			}
+			uint32_t intid = *(const uint32_t *)timer_prop;
+			if (intid < 16 || intid >= 32) {
+				panic("%s: virtual timer INTID %u is not a PPI", __func__, intid);
+			}
+			sweet_vtimer_intid = intid;
+		}
+
+		vm_offset_t soc_base_phys = pe_arm_get_soc_base_phys();
+		uint64_t const *reg = (uint64_t const *) prop;
+
+		gicd_base = ml_io_map(soc_base_phys + reg[0], reg[1]);
+		if (!gicd_base) {
+			panic("%s: cannot map GICD region", __func__);
+		}
+		gicc_base = ml_io_map(soc_base_phys + reg[2], reg[3]);
+		if (!gicc_base) {
+			panic("%s: cannot map GICC region", __func__);
+		}
+		kprintf("ONCLITE GIC: GICv2 typer=0x%x virtual timer INTID %u\n",
+		    gicd_read32(GICD_TYPER), sweet_vtimer_intid);
+	}
+
+	/*
+	 * Banked per core: GICD_ITARGETSR0..7 (SGIs) read as this core's own
+	 * CPU interface bit. That is the target list for SGIs to this core.
+	 */
+	uint32_t self = gicd_read32(GICD_ITARGETSR) & 0xff;
+	if (self == 0 || (self & (self - 1)) != 0) {
+		panic("%s: core %u has no single GIC CPU interface (ITARGETSR0=0x%x)",
+		    __func__, ml_get_cpu_number_local(), self);
+	}
+	os_atomic_store(&gic_cpu_iface_mask[ml_get_cpu_number_local()], (uint8_t)self, release);
+
+	/* SGIs and PPIs (INTID 0-31) are banked: priority and enable per core. */
+	for (unsigned int i = 0; i < 32; i++) {
+		_gic_write8(gicd_base + GICD_IPRIORITYR + i, 0xa0);
+	}
+	gicd_write32(GICD_ICENABLER0, 0xffffffff & ~((1U << sweet_vtimer_intid) | (1U << SWEET_IPI_SGI)));
+	gicd_write32(GICD_ISENABLER0, (1U << sweet_vtimer_intid) | (1U << SWEET_IPI_SGI));
+
+	gicc_write32(GICC_PMR, 0xff);
+	gicc_write32(GICC_BPR, 0);
+	gicc_write32(GICC_CTLR, gicc_read32(GICC_CTLR) | GICC_CTLR_ENABLEGRP1);
+	gicd_write32(GICD_CTLR, gicd_read32(GICD_CTLR) | GICD_CTLR_ENABLEGRP1);
+	__builtin_arm_dsb(DSB_SY);
+	__builtin_arm_isb(ISB_SY);
+}
+
+/* sleh_irq: acknowledge (GICC_IAR) and complete (GICC_EOIR) one interrupt. */
+uint32_t
+sweet_gic_ack(void)
+{
+	return gicc_read32(GICC_IAR);
+}
+
+void
+sweet_gic_eoi(uint32_t iar)
+{
+	gicc_write32(GICC_EOIR, iar);
+}
+
+/* SGI to one logical CPU, through its GICv2 CPU interface bit. */
+void
+sweet_gic_send_sgi(unsigned int cpu, unsigned int sgi)
+{
+	if (cpu >= MAX_CPUS || gic_cpu_iface_mask[cpu] == 0) {
+		panic("%s: cpu %u has no known GIC CPU interface", __func__, cpu);
+	}
+	__builtin_arm_dsb(DSB_ISHST);
+	gicd_write32(GICD_SGIR, ((uint32_t)gic_cpu_iface_mask[cpu] << GICD_SGIR_TARGET_SHIFT) | (sgi & 0xf));
+}
+
+/* SweetCPU::startAll: the target has run pe_init_fiq (its interface is known). */
+boolean_t
+sweet_gic_cpu_ready(unsigned int cpu)
+{
+	return cpu < MAX_CPUS && os_atomic_load(&gic_cpu_iface_mask[cpu], acquire) != 0;
+}
 #else
 void
 pe_init_fiq()
